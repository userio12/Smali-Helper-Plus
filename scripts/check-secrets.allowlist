# These files only mention secret NAMES (ANDROID_KEYSTORE_PASSWORD etc.) or use placeholders.
# They are still scanned for private keys and well-known token formats.
README.md
SECRETS_SETUP.md
CI_SETUP.md
VERSIONS.md
docs/TESTING.md
.github/workflows/*.yml
